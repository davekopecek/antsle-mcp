# Copy to .env (next to package.json) and fill in. .env is gitignored.
# Variables passed in by your MCP client override values in this file.

# Base URL of antMan: your antsle.us address, or the LAN address (antMan listens on port 3000).
ANTSLE_URL=https://myantsle.antsle.us
# ANTSLE_URL=http://myantsle.local:3000

# antMan login. The server fetches a JWT from /api/login and refreshes it as needed.
ANTSLE_USERNAME=root
ANTSLE_PASSWORD=

# Alternatively, a pre-issued token (with or without the "Token " prefix), used instead of logging in.
# ANTSLE_TOKEN=

# Only register read-only tools.
ANTSLE_READ_ONLY=false

# Register antsle_api_request, a raw passthrough to any antMan endpoint.
ANTSLE_ENABLE_RAW_API=false

# Request timeout in milliseconds.
ANTSLE_TIMEOUT_MS=60000
